# Inside a shipped run directory, drop what no reader opens. The soak arm alone
# carried 44 MB of these for a single cited number.
artifacts/*/phases/
artifacts/*/*timeslices*
artifacts/*/server_metrics_export.*
artifacts/*/profile_export.jsonl
artifacts/*/gpu_telemetry_export.jsonl
artifacts/*/inputs.json
artifacts/*/*/inputs.json
artifacts/*/logs/
artifacts/*/*/server_metrics_export.*
artifacts/*/*/*timeslices*
artifacts/*/*/profile_export.jsonl
artifacts/*/*/gpu_telemetry_export.jsonl
artifacts/*/*/logs/
# server.log.after is up to 2.2 MB per arm and only two are ever parsed - the
# MTP acceptance rates in section 11 come from these two.
artifacts/*/server.log.after
!artifacts/fn_code_tune_llamacpp_20260905T220846Z/server.log.after
!artifacts/fn_code_tune_llamacpp_20260905T222937Z/server.log.after

# Working notes, not deliverables. The lab record (every defect, every void run,
# the queue of what to try next) is written for the operator, not for someone
# cloning the repo - same reason FINDINGS.md / TODO.md / PLAN.md / NOTES.md are
# ignored above. Anything a reader needs is stated in the report itself, which
# cites no blocker IDs.
auto_run/
results/BLOCKERS.md
results/SLIDES.md
